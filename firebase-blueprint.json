{
  "projectSettings": {
    "authEnabled": true,
    "defaultRulesLevel": "authenticated"
  },
  "collections": [
    {
      "name": "projects",
      "description": "Stores shared drafts and published Instagram carousel projects for team collaboration",
      "schema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ID of the user who created the project"
          },
          "creatorEmail": {
            "type": "string",
            "description": "Email of user who created the project"
          },
          "creatorName": {
            "type": "string",
            "description": "Name of user who created the project"
          },
          "lastUpdatedByEmail": {
            "type": "string",
            "description": "Email of user who last modified the project"
          },
          "lastUpdatedByName": {
            "type": "string",
            "description": "Name of user who last modified the project"
          },
          "title": {
            "type": "string",
            "description": "The title of the project"
          },
          "data": {
            "type": "string",
            "description": "JSON serialized string of the project data (slides, etc)"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "ready_for_publishing", "published", "draft"],
            "description": "Project progress status: not_started, in_progress, ready_for_publishing, published"
          },
          "createdAt": {
            "type": "timestamp"
          },
          "updatedAt": {
            "type": "timestamp"
          }
        },
        "required": ["userId", "title", "data", "status", "updatedAt"]
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null",
        "update": "request.auth != null",
        "delete": "request.auth != null"
      }
    },
    {
      "name": "users",
      "description": "Registered user accounts visible to admin kianoshsolheim@gmail.com",
      "schema": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "description": "Firebase Auth user ID"
          },
          "email": {
            "type": "string",
            "description": "User email address"
          },
          "displayName": {
            "type": "string",
            "description": "User display name"
          },
          "photoURL": {
            "type": "string",
            "description": "User avatar URL"
          },
          "createdAt": {
            "type": "timestamp"
          },
          "lastLoginAt": {
            "type": "timestamp"
          }
        },
        "required": ["uid", "email"]
      },
      "rules": {
        "read": "request.auth != null",
        "create": "request.auth != null && request.auth.uid == userId",
        "update": "request.auth != null && request.auth.uid == userId",
        "delete": "request.auth != null && request.auth.token.email.lower() == 'kianoshsolheim@gmail.com'"
      }
    }
  ]
}
